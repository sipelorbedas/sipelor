# SIPELOR Environment Configuration
# ================================
# Setup Instructions:
# 1. Copy this file to .env (the actual file is in .gitignore)
# 2. Fill in your actual Supabase credentials
# 3. NEVER commit .env to version control

# ==================== SUPABASE CONFIGURATION ====================
# Get these values from your Supabase project settings
# https://app.supabase.com/project/_/settings/api

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ==================== SENTRY CONFIGURATION ====================
# Optional: Error tracking and monitoring
# Get this from https://sentry.io/settings/projects/

SENTRY_DSN=https://your_sentry_dsn_here

# ==================== BUILD CONFIGURATION ====================
# Optional: Build environment settings
# Values: development, staging, production

BUILD_ENV=development
#
# For production builds, use --dart-define instead:
#   flutter build apk \
#     --dart-define=SUPABASE_URL=your_url \
#     --dart-define=SUPABASE_ANON_KEY=your_key

# Application Environment
APP_ENV=development
# Options: development, staging, production

# API Configuration
API_TIMEOUT=30
# Request timeout in seconds

# Feature Flags (optional)
ENABLE_BIOMETRIC_AUTH=true
ENABLE_AUTO_LOGOUT=true
ENABLE_RATE_LIMITING=true

# Debug Settings (development only)
DEBUG_MODE=true
ENABLE_VERBOSE_LOGGING=false

# Sentry Error Tracking (Optional for Development)
# ⚠️ IMPORTANT: Keep this DSN confidential!
# For production builds, DSN is included in build script
# Uncomment to enable Sentry in development mode:
# SENTRY_DSN=https://your_sentry_dsn_here
